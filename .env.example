# ==============================================================================
# TEMPLATE KONFIGURASI: CaRI-Siber ID
# Cognitive Domain Intelligence & Narrative Threat Monitoring Platform
# Salin file ini menjadi .env dan isi API Key yang sesuai jika diperlukan
# ==============================================================================

# AI Provider Default (gemini | openrouter | edgeone | custom)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# API Keys (Opsional: Dapat juga diisi langsung melalui menu Pengaturan di aplikasi desktop)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
EDGEONE_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://api.tokenai.id/v1

# YouTube Data API v3 (Opsional: Scraper otomatis menggunakan fallback jika kosong)
YOUTUBE_API_KEY=

# Agentic AI Hardened Gates Configuration
AGENTIC_GATES_ENABLED=true
AGENTIC_MAX_RETRIES=2
AGENTIC_TOPIC_MAX_OUTLIER_RATIO=0.35
AGENTIC_VERIFY_MIN_CONFIDENCE_RATE=0.70

# Output Directory
OUTPUT_DIR=output
